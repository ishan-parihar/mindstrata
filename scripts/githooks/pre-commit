#!/bin/sh
# AGENTS.md §3 made mechanical: staged content must fmt+clippy clean.
# Skips behavioral tests (suite runs separately per §3); blocks red landings.
# plan-rust-craft C1: the clippy check matches the gate (--all-targets,
# -D warnings, exit code), and the staging gate is per-file — the old
# `case "$STAGED" in *.rs)` matched the whole newline-joined string, so a
# mixed .rs+.md staging whose last file was not .rs skipped every check.
git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$' || exit 0
cargo fmt --all --check || {
  echo "pre-commit: cargo fmt --check failed (run: cargo fmt --all)" >&2; exit 1; }
cargo clippy --workspace --all-targets --locked -- -D warnings || {
  echo "pre-commit: clippy warnings/errors present (fix or justify via #[expect])" >&2; exit 1; }
exit 0
