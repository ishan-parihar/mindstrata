#!/usr/bin/env bash
# Full verification gate — run before EVERY push (§3 discipline).
# The pre-commit hook covers fmt+clippy cheaply; this adds the release
# suite + both golden baselines. Behavioral iterations MUST pass this.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FULL=0
[ "${1:-}" = "--full" ] && FULL=1

echo "[gate 1/3] fmt --check"
cargo fmt --all --check

echo "[gate 2/3] clippy --workspace"
cargo clippy --workspace --quiet 2>&1 | grep -E "^warning|^error" && {
    echo "CLIPPY NOT CLEAN"; exit 1; } || true

echo "[gate 2.5/3] bench naming law (IC-4)"
python3 scripts/bench_index.py --strict 2>&1 | tail -5
python3 scripts/bench_index.py --strict

# Documentation authority map (docs/DOCUMENTATION.md §5): every non-exempt doc
# must be classified in the index, no ghost entries, and AUTHORITY/ACTIVE docs
# must carry a resolvable reconciliation marker. This is what stops the doctrine
# pointer / current-state doc from silently diverging from the code again.
echo "[gate 2.5b/3] documentation authority map"
python3 scripts/doc_index.py --check

# DC3-P0 §5.1 (i295): golden-budget envelopes as WARN-ONLY drift visibility —
# N=12 ≤150 µs/tick (golden-suite wall budget), N=96 ≤6500 (Phase-1 target).
# Release noise (±8%) on shared hosts must not block commits, but drift must
# be visible every gate run. Hard floors stay with i270/i271 (gate 2.6).
echo "[gate 2.55/3] perf budgets warn-only (charter DC3-P0 §2)"
cargo run --release -q -p mindstrata-benches --example i295_perf_budget_gate

# DC-1 TOOLS 19-22: seed-family sweep is the calibration-audit-v2
# CA-1/CA-2/CA-4 instrument. Run it in --quick (12 seeds, 4000 ticks)
# on every non-full gate so a single broken seed is caught before
# commit. Full gate skips this (the i268 output is informational;
# the i268 results are pinned in golden baselines via the golden
# custody contract).
SweepOutput=$(cargo run --release -p mindstrata-benches --example i268_seed_family_sweep 2>&1)
echo "$SweepOutput" | tail -3
if ! echo "$SweepOutput" | grep -q "verdict=FAMILY_PASS"; then
    echo "SEED FAMILY SWEEP FAILED"
    exit 1
fi

if [ "$FULL" -eq 1 ]; then
    echo "[gate 2.6/3] perf budgets --quick (IC-8 + perf-budget.md floor)"
    cargo run --release -p mindstrata-benches --example i271_render_perf -- --quick
    cargo run --release -p mindstrata-benches --example i270_perf_snapshot -- --quick
fi

if [ "$FULL" -eq 1 ]; then
    echo "[gate 3/3] tests-crate release suite (+ golden baselines)"
    cargo test -p mindstrata-tests --lib --release
else
    echo "[gate 3/3] golden baselines only (--full adds the whole suite)"
    cargo test -p mindstrata-tests --lib --release golden_replay
fi

echo "GATE GREEN"
