// §45.5 Norm definitions — every norm has sanction, scope, and enforcement.
// The spec linter validates that every norm has a sanction and scope.

Norms(
    norms: [
        Norm(
            id: "do_not_steal",
            name: "Do Not Steal",
            scope: Settlement,
            strength: 0.85,
            internalization_bias: 0.7,
            sanction: Fine(0.1),
            enforcement: Council,
            legitimacy_dependency: true,
            emotional_response: [Guilt, Shame],
            visibility_required: true,
        ),
        Norm(
            id: "do_not_threaten",
            name: "Do Not Threaten Others",
            scope: Settlement,
            strength: 0.9,
            internalization_bias: 0.8,
            sanction: TrustPenalty(0.15),
            enforcement: Council,
            legitimacy_dependency: true,
            emotional_response: [Guilt, Shame, Fear],
            visibility_required: true,
        ),
        Norm(
            id: "hard_work_norm",
            name: "Hard Work Is Valued",
            scope: Community,
            strength: 0.6,
            internalization_bias: 0.5,
            sanction: ReputationPenalty(0.05),
            enforcement: Peer,
            legitimacy_dependency: false,
            emotional_response: [Pride],
            visibility_required: false,
        ),
        Norm(
            id: "community_norm",
            name: "Community Participation",
            scope: Community,
            strength: 0.5,
            internalization_bias: 0.4,
            sanction: ReputationPenalty(0.03),
            enforcement: Peer,
            legitimacy_dependency: false,
            emotional_response: [Guilt],
            visibility_required: false,
        ),
        Norm(
            id: "religious_norm",
            name: "Religious Observance",
            scope: Temple,
            strength: 0.55,
            internalization_bias: 0.6,
            sanction: ReputationPenalty(0.04),
            enforcement: Priest,
            legitimacy_dependency: true,
            emotional_response: [Guilt, Shame],
            visibility_required: true,
        ),
        Norm(
            id: "private_property",
            name: "Respect Private Property",
            scope: Settlement,
            strength: 0.8,
            internalization_bias: 0.6,
            sanction: Fine(0.15),
            enforcement: Council,
            legitimacy_dependency: true,
            emotional_response: [Guilt, Shame, Anger],
            visibility_required: true,
        ),
    ],
)
