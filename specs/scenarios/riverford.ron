// §46 Scenario DSL — Riverford Minor
// Base scenario: a small village with 12 agents, basic economy, and institutions.

Scenario(
    name: "Riverford Minor",
    description: "A small village with farmland, a well, a market, and a temple. Agents must survive by eating, drinking, and working.",
    seed: 42,
    ticks: 4320,
    world_width: 16,
    world_height: 16,
    num_agents: 12,
    shocks: [
        Shock(
            at_tick: 200,
            kind: Festival,
            magnitude: 0.5,
        ),
        Shock(
            at_tick: 500,
            kind: Drought,
            magnitude: 0.3,
        ),
    ],
)
