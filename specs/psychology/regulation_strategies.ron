            personality_traditionalism_bonus: 0.2,
            synchrony_bonus: 0.2,
            group_participation_bonus: 0.15,
            stress_reduction_rate: 0.02,
        ),
        RegulationStrategy(
            name: "Aggression",
            description: "redirect emotional energy into hostile action",
            effectiveness_base: 0.2,
            requires_cognitive_capacity: 0.1,
            personality_agreeableness_penalty: 0.2,
            personality_neuroticism_bonus: 0.15,
            dominance_axis_weight: 0.2,
            short_term_benefit: 0.2,
            long_term_relationship_cost: 0.3,
        ),
        RegulationStrategy(
            name: "Humor",
            description: "use humor to reframe and defuse emotional intensity",
