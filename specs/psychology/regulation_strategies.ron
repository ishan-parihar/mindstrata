            effectiveness_base: 0.4,
            requires_cognitive_capacity: 0.1,
            personality_neuroticism_bonus: 0.2,
            personality_openness_penalty: 0.15,
            short_term_benefit: 0.3,
            long_term_cost: 0.2,
        ),
        RegulationStrategy(
            name: "SeekingSupport",
            description: "turn to trusted others for comfort and advice",
            effectiveness_base: 0.5,
            requires_cognitive_capacity: 0.2,
            personality_extraversion_bonus: 0.2,
            social_support_weight: 0.3,
            attachment_security_bonus: 0.25,
            stress_penalty: 0.1,
        ),
        RegulationStrategy(
            name: "Prayer",
            description: "seek meaning and comfort through spiritual practice",
            effectiveness_base: 0.4,
            requires_cognitive_capacity: 0.1,
            personality_traditionalism_bonus: 0.25,
            meaning_need_weight: 0.2,
            ritual_participation_bonus: 0.15,
