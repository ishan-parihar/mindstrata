// §8.1.4 Emotion regulation strategies — defines how agents manage emotions.
// Used by psychology/emotion_regulation.rs to model emotional coping.

RegulationStrategies(
    strategies: [
        RegulationStrategy(
            name: "Reappraisal",
            description: "reinterpret the situation to change its emotional impact",
            effectiveness_base: 0.6,
            requires_cognitive_capacity: 0.5,
            personality_openness_bonus: 0.2,
            personality_neuroticism_penalty: 0.15,
            stress_penalty: 0.1,
            fatigue_penalty: 0.1,
            social_support_bonus: 0.1,
        ),
        RegulationStrategy(
            name: "Suppression",
            description: "inhibit emotional expression without changing the feeling",
            effectiveness_base: 0.3,
            requires_cognitive_capacity: 0.3,
            personality_conscientiousness_bonus: 0.15,
            personality_neuroticism_penalty: 0.2,
            stress_penalty: 0.2,
            fatigue_penalty: 0.15,
            long_term_cost: 0.1,
        ),
        RegulationStrategy(
            name: "Rumination",
            description: "repetitively focus on the emotional experience",
            effectiveness_base: 0.1,
            requires_cognitive_capacity: 0.2,
            personality_neuroticism_bonus: 0.3,
            personality_conscientiousness_penalty: 0.1,
            stress_amplification: 0.2,
            fatigue_penalty: 0.05,
            long_term_cost: 0.15,
        ),
        RegulationStrategy(
