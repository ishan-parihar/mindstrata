// §7.2.6 Life stages — defines developmental stages and transitions.
// Used by biology/development.rs to model agent development.

LifeStages(
    stages: [
        LifeStage(
            name: "Infant",
            age_min: 0.0,
            age_max: 2.0,
            description: "Complete dependency, attachment formation",
            cognitive_capacity: 0.1,
            physical_capacity: 0.05,
            social_capacity: 0.05,
            reproductive_capable: false,
            needs_high_dependency: true,
            caregiver_required: true,
        ),
        LifeStage(
            name: "Child",
            age_min: 2.0,
            age_max: 12.0,
            description: "Learning, socialization, play, skill acquisition",
            cognitive_capacity: 0.4,
            physical_capacity: 0.3,
            social_capacity: 0.4,
            reproductive_capable: false,
            needs_high_dependency: false,
            caregiver_required: false,
        ),
        LifeStage(
            name: "Adolescent",
            age_min: 12.0,
            age_max: 18.0,
            description: "Puberty, identity formation, peer sensitivity",
            cognitive_capacity: 0.7,
            physical_capacity: 0.6,
            social_capacity: 0.7,
            reproductive_capable: true,
            needs_high_dependency: false,
            caregiver_required: false,
            puberty_effects: (
                fertility_axis_activation: 0.8,
                status_sensitivity_increase: 0.3,
                attraction_salience_increase: 0.4,
                identity_experimentation: 0.5,
                peer_sensitivity_increase: 0.4,
                risk_taking_increase: 0.3,
            ),
        ),
        LifeStage(
            name: "YoungAdult",
            age_min: 18.0,
            age_max: 30.0,
            description: "Peak physical capacity, pair-bonding readiness",
            cognitive_capacity: 0.9,
            physical_capacity: 0.9,
            social_capacity: 0.8,
            reproductive_capable: true,
            needs_high_dependency: false,
            caregiver_required: false,
        ),
        LifeStage(
            name: "Adult",
            age_min: 30.0,
            age_max: 50.0,
            description: "Mature, experienced, institutional roles",
            cognitive_capacity: 1.0,
            physical_capacity: 0.8,
            social_capacity: 0.9,
            reproductive_capable: true,
            needs_high_dependency: false,
            caregiver_required: false,
        ),
        LifeStage(
            name: "MatureAdult",
            age_min: 50.0,
            age_max: 65.0,
            description: "Generativity, wisdom, declining physical capacity",
            cognitive_capacity: 0.9,
            physical_capacity: 0.6,
            social_capacity: 0.9,
            reproductive_capable: false,
            needs_high_dependency: false,
            caregiver_required: false,
        ),
        LifeStage(
            name: "Elder",
            age_min: 65.0,
            age_max: 100.0,
            description: "Frailty, wisdom, dependency, legacy",
            cognitive_capacity: 0.7,
            physical_capacity: 0.3,
            social_capacity: 0.8,
            reproductive_capable: false,
            needs_high_dependency: true,
            caregiver_required: false,
        ),
    ],

    // Developmental processes
    processes: (
        attachment_formation_ticks: 5000,
        temperament_expression_ticks: 3000,
        socialization_ticks: 10000,
        identity_formation_ticks: 8000,
        moral_development_ticks: 12000,
        skill_acquisition_rate: 0.01,
        puberty_onset_age_range: [12.0, 16.0],
        pair_bonding_readiness_age: 18.0,
        generativity_onset_age: 40.0,
        aging_decline_rate: 0.001,
    ),

    // Childhood environment effects
    childhood_environment: (
        caregiver_security_weight: 0.4,
        nutrition_history_weight: 0.3,
        trauma_history_weight: 0.3,
        socialization_style_effect: {
            "Authoritative": 0.3,
            "Authoritarian": 0.2,
            "Permissive": 0.1,
            "Neglectful": -0.2,
        },
    ),
)
